{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/talvikai/mak4i-protocol/main/schemas/grant.schema.json",
  "title": "Project grant",
  "description": "Binding of one principal to one project with permissions (MAK-0006 \u00a75).",
  "x-mak4i-schema-version": "0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "principal_id",
    "project_id",
    "permissions"
  ],
  "properties": {
    "grant_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "principal_id": {
      "$ref": "common.schema.json#/$defs/principalId"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/projectId"
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/permission"
      }
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
