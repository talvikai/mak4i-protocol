{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/talvikai/mak4i-protocol/main/schemas/common.schema.json",
  "title": "MAK4I common definitions",
  "description": "Shared definitions used by the MAK4I schemas (MAK-0004, MAK-0005, MAK-0006, MAK-0008, MAK-0009).",
  "x-mak4i-schema-version": "0.3.0",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp with offset."
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "organizationId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "principalId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "projectId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "artifactId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "agentId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{1,62}[a-z0-9])$",
      "description": "MAK-0006 \u00a73.2"
    },
    "principalType": {
      "enum": [
        "human",
        "service",
        "agent"
      ]
    },
    "permission": {
      "enum": [
        "read",
        "write",
        "resolve",
        "govern"
      ],
      "description": "MAK-0006 \u00a75.1. `govern` is architecture-defined (MAK-0009 \u00a76.2) and not part of any conformance profile yet."
    },
    "scope": {
      "enum": [
        "mak4i:read",
        "mak4i:write",
        "mak4i:resolve"
      ]
    },
    "subjectKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "description": "Normalized subject key (MAK-0005 \u00a7A5.2): no leading/trailing whitespace."
    },
    "conflictId": {
      "type": "string",
      "pattern": "^cfl_[0-9a-f]{32}$"
    },
    "resolutionId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "resourceId": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "MAK-0009 \u00a73.1"
    },
    "resourceGroupId": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "MAK-0009 \u00a73.2"
    },
    "scopeType": {
      "enum": [
        "organization",
        "project",
        "resource_group",
        "resource"
      ],
      "description": "MAK-0009 \u00a71.2"
    },
    "scopeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/scopeType"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "description": "A node of the organization \u2192 project \u2192 resource group \u2192 resource hierarchy (MAK-0009 \u00a71.2)."
    },
    "ruleKey": {
      "$ref": "#/$defs/subjectKey",
      "description": "Normalized like a subject key (MAK-0009 \u00a74.2)."
    },
    "enforcement": {
      "enum": [
        "default",
        "mandatory"
      ],
      "description": "MAK-0009 \u00a74.3"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "Semantic version of a distributable artifact (MAK-0009 \u00a72.3). Not a project-record revision."
    },
    "httpsOrLoopbackUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^(https://|http://(127\\.0\\.0\\.1|\\[::1\\]|localhost)(:[0-9]+)?(/|$))",
      "description": "HTTPS, or http on a loopback host only (MAK-0008 \u00a71.2, \u00a73)."
    },
    "protocolInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "profiles"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
          "description": "Protocol release the implementation targets (SPEC.md)."
        },
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "server-project-records",
              "server-client-policies",
              "server-change-feed",
              "transport-stdio",
              "transport-http-credential",
              "transport-http-oauth",
              "oauth-cimd",
              "oauth-dcr",
              "client-sdk",
              "artifact"
            ]
          }
        }
      },
      "description": "MAK-0008 \u00a710.5; profiles from CONFORMANCE.md."
    },
    "clientIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "credential",
            "oauth_client"
          ]
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "description": "Verified client identity derived from the authentication (MAK-0006 \u00a75.7.1). `id` is a credential_id for kind credential and an OAuth client_id (pre-registered or metadata-document URL) for kind oauth_client."
    }
  }
}
