{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/talvikai/mak4i-protocol/main/schemas/artifact-pin.schema.json",
  "title": "Organization artifact pin",
  "description": "A project's pin of an organization artifact to one published package version (MAK-0009 \u00a72.2). Ignored for artifacts carrying a mandatory rule and for withdrawn artifacts. Architecture-defined.",
  "x-mak4i-schema-version": "0.3.0",
  "x-mak4i-status": "architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "project",
    "artifact_id",
    "package_version",
    "pinned_by",
    "pinned_at"
  ],
  "properties": {
    "organization_id": {
      "$ref": "common.schema.json#/$defs/organizationId"
    },
    "project": {
      "$ref": "common.schema.json#/$defs/projectId"
    },
    "artifact_id": {
      "$ref": "common.schema.json#/$defs/artifactId"
    },
    "package_version": {
      "$ref": "common.schema.json#/$defs/packageVersion"
    },
    "pinned_by": {
      "$ref": "provenance.schema.json"
    },
    "pinned_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
