{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/talvikai/mak4i-protocol/main/schemas/project-record.schema.json",
  "title": "Governed project record version",
  "description": "One version of a governed project record (MAK-0005 Part A).",
  "x-mak4i-schema-version": "0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "organization_id",
    "project",
    "title",
    "content",
    "status",
    "version",
    "lineage_id",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "artifact_id": {
      "$ref": "common.schema.json#/$defs/artifactId"
    },
    "artifact_type": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "organization_id": {
      "$ref": "common.schema.json#/$defs/organizationId"
    },
    "project": {
      "$ref": "common.schema.json#/$defs/projectId"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "content": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      }
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "withdrawn"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.0$"
    },
    "lineage_id": {
      "$ref": "common.schema.json#/$defs/artifactId"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/artifactId"
        },
        {
          "type": "null"
        }
      ]
    },
    "superseded_by": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/artifactId"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_key": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/subjectKey"
        },
        {
          "type": "null"
        }
      ]
    },
    "released_subject_key": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/subjectKey"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_by": {
      "$ref": "common.schema.json#/$defs/principalId"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "provenance.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Absent or null only on legacy versions (MAK-0005 \u00a7A2)."
    },
    "resolution_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/resolutionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "merged_from": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "common.schema.json#/$defs/artifactId"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "resource_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        {
          "type": "null"
        }
      ],
      "x-mak4i-status": "architecture",
      "description": "Attachment to one resource of the same project (MAK-0009 \u00a73.4). Architecture-defined: not required by any conformance profile; absent or null = project-wide."
    },
    "rule": {
      "anyOf": [
        {
          "$ref": "rule.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "x-mak4i-status": "architecture",
      "description": "Present when the record is a rule (MAK-0009 \u00a74.1). Architecture-defined."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "superseded_by"
        ],
        "properties": {
          "superseded_by": {
            "$ref": "common.schema.json#/$defs/artifactId"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "withdrawn"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "resolution_id"
        ],
        "properties": {
          "resolution_id": {
            "$ref": "common.schema.json#/$defs/resolutionId"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "supersedes": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": [
          "supersedes"
        ],
        "properties": {
          "supersedes": {
            "$ref": "common.schema.json#/$defs/artifactId"
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "subject_key",
          "released_subject_key"
        ],
        "properties": {
          "subject_key": {
            "$ref": "common.schema.json#/$defs/subjectKey"
          },
          "released_subject_key": {
            "$ref": "common.schema.json#/$defs/subjectKey"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "rule"
        ],
        "properties": {
          "rule": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "rule": {
            "properties": {
              "applies_to": {
                "properties": {
                  "type": {
                    "enum": [
                      "project",
                      "resource_group",
                      "resource"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "description": "A project-record rule applies at its project or below, never at organization scope (MAK-0009 \u00a74.2)."
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "superseded_by": {
            "type": "null"
          }
        }
      },
      "description": "A head has no successor (MAK-0005 \u00a7A4)."
    },
    {
      "if": {
        "required": [
          "merged_from"
        ],
        "properties": {
          "merged_from": {
            "type": "array"
          }
        }
      },
      "then": {
        "required": [
          "resolution_id"
        ],
        "properties": {
          "resolution_id": {
            "$ref": "common.schema.json#/$defs/resolutionId"
          }
        }
      },
      "description": "A merge result carries its resolution (MAK-0004 \u00a7A7.4)."
    }
  ],
  "patternProperties": {
    "^x_[a-z0-9]+_[a-z0-9_]+$": {}
  }
}
