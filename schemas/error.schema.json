{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/talvikai/mak4i-protocol/main/schemas/error.schema.json",
  "title": "Tool error",
  "description": "structuredContent of a failed tool result (MAK-0008 §9).",
  "x-mak4i-schema-version": "0.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "access_denied",
            "identity_mismatch",
            "validation_error",
            "not_found",
            "artifact_exists",
            "subject_exists",
            "idempotency_key_reused",
            "artifact_not_active",
            "stale_head",
            "subject_key_change",
            "subject_in_conflict",
            "conflict_changed",
            "conflict_not_open",
            "subject_collision",
            "cursor_expired",
            "rate_limited",
            "internal_error"
          ]
        },
        "message": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "retryable": {
          "type": "boolean"
        },
        "correlation_id": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z_]+$",
          "examples": [
            "client_not_permitted",
            "server_assigned_id"
          ],
          "description": "More specific cause within `code` (MAK-0008 \u00a79.2). Clients ignore unknown reasons."
        },
        "details": {
          "type": "object",
          "description": "Structured data defined per code (MAK-0008 §9.2). For subject_exists, present only when the caller holds read (MAK-0005 §A5.6).",
          "additionalProperties": false,
          "properties": {
            "current_artifact_ids": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/artifactId"
              },
              "description": "Readable current heads of the occupied subject, in artifact_id order. May hold legacy identifiers."
            },
            "hidden_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "patternProperties": {
            "^x_[a-z0-9]+_[a-z0-9_]+$": {}
          }
        }
      }
    }
  },
  "patternProperties": {
    "^x_[a-z0-9]+_[a-z0-9_]+$": {}
  }
}
