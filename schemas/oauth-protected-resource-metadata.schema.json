{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/talvikai/mak4i-protocol/main/schemas/oauth-protected-resource-metadata.schema.json",
  "title": "MAK4I protected resource metadata profile",
  "description": "RFC 9728 metadata constrained by MAK-0008 \u00a74.1.",
  "x-mak4i-schema-version": "0.2.0",
  "type": "object",
  "required": [
    "resource",
    "authorization_servers",
    "scopes_supported",
    "bearer_methods_supported"
  ],
  "properties": {
    "resource": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/httpsUrl"
        },
        {
          "not": {
            "pattern": "[?#]|/$"
          }
        }
      ]
    },
    "authorization_servers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/httpsUrl"
      }
    },
    "scopes_supported": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/scope"
      }
    },
    "bearer_methods_supported": {
      "const": [
        "header"
      ]
    },
    "resource_name": {
      "type": "string"
    },
    "resource_documentation": {
      "type": "string",
      "format": "uri"
    }
  }
}
