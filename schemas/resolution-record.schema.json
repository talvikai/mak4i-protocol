{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/talvikai/mak4i-protocol/main/schemas/resolution-record.schema.json",
  "title": "Conflict resolution record",
  "description": "Durable record of one resolution (MAK-0004 \u00a7A7.6).",
  "x-mak4i-schema-version": "0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resolution_id",
    "conflict_id",
    "organization_id",
    "project",
    "artifact_type",
    "subject_key",
    "generation",
    "action",
    "parameters",
    "reason",
    "candidate_artifact_ids",
    "actor",
    "permission",
    "effects",
    "resulting_heads",
    "state",
    "created_at",
    "completed_at",
    "idempotency_key"
  ],
  "properties": {
    "resolution_id": {
      "$ref": "common.schema.json#/$defs/resolutionId"
    },
    "conflict_id": {
      "$ref": "common.schema.json#/$defs/conflictId"
    },
    "organization_id": {
      "$ref": "common.schema.json#/$defs/organizationId"
    },
    "project": {
      "$ref": "common.schema.json#/$defs/projectId"
    },
    "artifact_type": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "subject_key": {
      "$ref": "common.schema.json#/$defs/subjectKey"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "enum": [
        "select_winner",
        "merge",
        "separate_subjects"
      ]
    },
    "parameters": {
      "type": "object"
    },
    "reason": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "candidate_artifact_ids": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "common.schema.json#/$defs/artifactId"
      },
      "uniqueItems": true
    },
    "actor": {
      "$ref": "provenance.schema.json"
    },
    "permission": {
      "const": "resolve"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "effect"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "common.schema.json#/$defs/artifactId"
          },
          "effect": {
            "enum": [
              "withdrawn",
              "superseded",
              "unchanged"
            ]
          },
          "successor_artifact_id": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/artifactId"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "effect": {
                  "const": "superseded"
                }
              },
              "required": [
                "effect"
              ]
            },
            "then": {
              "required": [
                "successor_artifact_id"
              ],
              "properties": {
                "successor_artifact_id": {
                  "$ref": "common.schema.json#/$defs/artifactId"
                }
              }
            }
          }
        ]
      }
    },
    "resulting_heads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_key",
          "artifact_id"
        ],
        "properties": {
          "subject_key": {
            "$ref": "common.schema.json#/$defs/subjectKey"
          },
          "artifact_id": {
            "$ref": "common.schema.json#/$defs/artifactId"
          }
        }
      }
    },
    "state": {
      "enum": [
        "pending",
        "completed",
        "aborted"
      ]
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "completed_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "pending"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "completed_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        }
      },
      "description": "completed_at is null exactly while pending (MAK-0004 \u00a7A8.2)."
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "select_winner"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "winner_artifact_id"
            ],
            "properties": {
              "winner_artifact_id": {
                "$ref": "common.schema.json#/$defs/artifactId"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "merge"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "into_artifact_id",
              "content"
            ],
            "properties": {
              "into_artifact_id": {
                "$ref": "common.schema.json#/$defs/artifactId"
              },
              "content": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "title": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "separate_subjects"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assignments"
            ],
            "properties": {
              "assignments": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "artifact_id",
                    "subject_key"
                  ],
                  "properties": {
                    "artifact_id": {
                      "$ref": "common.schema.json#/$defs/artifactId"
                    },
                    "subject_key": {
                      "$ref": "common.schema.json#/$defs/subjectKey"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "patternProperties": {
    "^x_[a-z0-9]+_[a-z0-9_]+$": {}
  }
}
